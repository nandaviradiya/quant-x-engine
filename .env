# ── Render.com environment defaults ───────────────────────────────────────────
# Render injects $PORT automatically; these are fallback defaults.

# Engine
ENGINE_HOST=0.0.0.0
ENGINE_PORT=10000
ENGINE_WORKERS=1

# Storage — paths inside the Docker container
PARQUET_DATA_DIR=/app/datasets
REPORTS_DIR=/app/reports
LOG_DIR=/app/logs

# SQLite mode — no PostgreSQL on Render free tier
USE_SQLITE=true
SQLITE_PATH=/app/data/quantx.db

# CORS — allow all origins so the desktop app can connect
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO

# API version
API_VERSION=v1

